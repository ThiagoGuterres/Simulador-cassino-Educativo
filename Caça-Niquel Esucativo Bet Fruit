<!DOCTYPE html>
<html lang="pt-BR" class="h-full bg-slate-900">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Simulador Educativo - O Perigo das Bets</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        /* Previne rolagem e seleções acidentais no toque do celular */
        body {
            touch-action: manipulation;
            -webkit-tap-highlight-color: transparent;
            user-select: none;
        }
        /* Animação de giro das roletas */
        @keyframes blurSpin {
            0% { transform: translateY(0); filter: blur(0); }
            50% { transform: translateY(-50%); filter: blur(4px); }
            100% { transform: translateY(0); filter: blur(0); }
        }
        .spinning {
            animation: blurSpin 0.25s infinite linear;
        }
    </style>
</head>
<body class="h-full flex flex-col justify-between text-slate-100 font-sans p-3 max-w-md mx-auto select-none overflow-x-hidden">

    <!-- CABEÇALHO -->
    <header class="text-center py-2 border-b border-slate-800 flex justify-between items-center">
        <div>
            <h1 class="text-base font-black tracking-wider text-amber-400 uppercase flex items-center gap-1">
                <span>🎰</span> ALERTA: BETS & CASSINOS
            </h1>
            <p class="text-[10px] text-slate-400">Demonstração Matemática do Lucro da Casa</p>
        </div>
        <button onclick="toggleModal(true)" class="bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold px-2.5 py-1.5 rounded-lg border border-indigo-400/30 flex items-center gap-1 shadow-sm">
            <span>ℹ️️</span> Entenda
        </button>
    </header>

    <!-- MÁQUINA CAÇA-NÍQUEL (INTERFACE VISUAL) -->
    <main class="my-auto py-2 space-y-3">

        <!-- PAINEL DE ROLETAS -->
        <div class="bg-slate-800/90 border-2 border-amber-500/40 rounded-2xl p-3 shadow-xl relative overflow-hidden">
            
            <!-- ALERTA DE QUASE-VITÓRIA (NEAR MISS) -->
            <div id="nearMissBanner" class="hidden absolute inset-x-0 top-0 bg-rose-600/95 text-white text-[11px] font-bold py-1 px-2 text-center animate-pulse z-20 shadow-md">
                ⚠️ ALGORITMO: "Quase Vitória" gerada para reter você no jogo!
            </div>

            <!-- AS 3 ROLETAS COM EMOJIS -->
            <div class="grid grid-cols-3 gap-2 my-2 bg-slate-950 p-3 rounded-xl border border-slate-700/80 shadow-inner">
                <div id="reel1" class="h-20 bg-slate-900 border border-amber-500/30 rounded-lg flex items-center justify-center text-4xl shadow-md">🍊</div>
                <div id="reel2" class="h-20 bg-slate-900 border border-amber-500/30 rounded-lg flex items-center justify-center text-4xl shadow-md">🍋</div>
                <div id="reel3" class="h-20 bg-slate-900 border border-amber-500/30 rounded-lg flex items-center justify-center text-4xl shadow-md">🍒</div>
            </div>

            <!-- RESULTADO DA RODADA -->
            <div id="statusText" class="text-center h-6 flex items-center justify-center text-xs font-bold text-amber-300">
                Aperte GIRAR para testar a sorte!
            </div>
        </div>

        <!-- MODO DE ALGORITMO (CONTROLE EXPERIMENTAL) -->
        <div class="bg-slate-800/50 p-2 rounded-xl border border-slate-700 flex items-center justify-between">
            <span class="text-xs font-semibold text-slate-300">Comportamento da Casa:</span>
            <select id="modeSelect" onchange="resetarSimulacao()" class="bg-slate-900 border border-slate-600 text-amber-400 text-xs font-bold rounded-lg px-2 py-1 outline-none">
                <option value="fair">Modo 1: Jogo Limpo (Margem Matemática 10%)</option>
                <option value="aggressive" selected>Modo 2: Script Agressivo (Armadilha RTP)</option>
            </select>
        </div>

        <!-- PLACAR FINANCEIRO -->
        <div class="grid grid-cols-2 gap-2 text-center">
            <div class="bg-slate-800/80 p-2 rounded-xl border border-emerald-500/30">
                <span class="text-[10px] text-slate-400 font-medium block">Seu Saldo (Jogador)</span>
                <span id="playerBalance" class="text-base font-black text-emerald-400">R$ 200,00</span>
            </div>
            <div class="bg-slate-800/80 p-2 rounded-xl border border-rose-500/30">
                <span class="text-[10px] text-slate-400 font-medium block">Lucro da Casa (Dono)</span>
                <span id="houseProfit" class="text-base font-black text-rose-400">R$ 0,00</span>
            </div>
        </div>

        <!-- CONTROLES DE AÇÃO (BOTÕES) -->
        <div class="grid grid-cols-3 gap-2">
            <button id="spinBtn" onclick="girar(1)" class="col-span-1 bg-gradient-to-b from-amber-400 to-amber-600 hover:from-amber-300 hover:to-amber-500 text-slate-950 font-black py-3 rounded-xl shadow-lg active:scale-95 transition text-sm">
                🎰 GIRAR
            </button>
            <button id="auto50Btn" onclick="girar(50)" class="col-span-1 bg-indigo-600 hover:bg-indigo-500 text-white font-bold py-3 rounded-xl shadow-md active:scale-95 transition text-xs flex flex-col items-center justify-center">
                <span>⚡ +50 Giros</span>
                <span class="text-[9px] font-normal opacity-80">(Estatística)</span>
            </button>
            <button onclick="resetarSimulacao()" class="col-span-1 bg-slate-700 hover:bg-slate-600 text-slate-300 font-bold py-3 rounded-xl shadow-md active:scale-95 transition text-xs flex items-center justify-center gap-1">
                🔄 Recarregar
            </button>
        </div>

        <!-- GRÁFICO EM TEMPO REAL -->
        <div class="bg-slate-800/60 p-2 rounded-xl border border-slate-700 h-36">
            <canvas id="financeChart"></canvas>
        </div>
    </main>

    <!-- RODAPÉ -->
    <footer class="text-center py-1 text-[10px] text-slate-500 border-t border-slate-800">
        Trabalho Educativo • Conscientização sobre Jogos de Azar
    </footer>

    <!-- MODAL INFORMATIVO PARA A EXPLICAÇÃO DO TRABALHO -->
    <div id="explainModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-slate-800 border border-slate-700 rounded-2xl p-5 max-w-sm w-full space-y-4 max-h-[90vh] overflow-y-auto">
            <h2 class="text-base font-bold text-amber-400 flex items-center gap-2">
                <span>🧠</span> Como a casa sempre vence?
            </h2>
            
            <div class="space-y-3 text-xs text-slate-300 leading-relaxed">
                <div class="p-2.5 bg-slate-900/80 rounded-lg border border-slate-700">
                    <strong class="text-white block mb-0.5">1. A Margem Embutida (House Edge):</strong>
                    Em jogos normais, o retorno teórico (RTP) é calculado para devolver menos do que é apostado no longo prazo. A matemática garante a falência do apostador.
                </div>

                <div class="p-2.5 bg-slate-900/80 rounded-lg border border-slate-700">
                    <strong class="text-white block mb-0.5">2. Script Agressivo (RTP Dinâmico):</strong>
                    Muitos cassinos não regulamentados dão vitórias fáceis nos primeiros giros para liberar dopamina e prender a atenção do jogador. Quando o jogador se empolga, o algoritmo reduz as chances quase a zero.
                </div>

                <div class="p-2.5 bg-slate-900/80 rounded-lg border border-slate-700">
                    <strong class="text-white block mb-0.5">3. Efeito Quase-Vitória (Near Miss):</strong>
                    O jogo simula duas frutas iguais e uma diferente de propósito. Isso faz o cérebro achar que "estava quase lá", estimulando mais apostas.
                </div>
            </div>

            <button onclick="toggleModal(false)" class="w-full bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold py-2 rounded-xl text-xs transition">
                Entendi, voltar à simulação
            </button>
        </div>
    </div>

    <!-- SCRIPT DE LÓGICA DO SIMULADOR E GRÁFICO -->
    <script>
        const FRUITS = ['🍒', '🍋', '🍊', '🍇', '🔔', '💎', '7️⃣'];
        const APOS_VALOR = 10;
        const SALDO_INICIAL = 200;

        let saldo = SALDO_INICIAL;
        let lucroCasa = 0;
        let totalGiros = 0;
        let isSpinning = false;

        // Configuração do Gráfico Chart.js
        const ctx = document.getElementById('financeChart').getContext('2d');
        const chart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: [0],
                datasets: [
                    {
                        label: 'Seu Saldo',
                        data: [SALDO_INICIAL],
                        borderColor: '#10b981',
                        borderWidth: 2,
                        pointRadius: 0,
                        tension: 0.1
                    },
                    {
                        label: 'Lucro da Casa',
                        data: [0],
                        borderColor: '#f43f5e',
                        borderWidth: 2,
                        pointRadius: 0,
                        tension: 0.1
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { labels: { color: '#94a3b8', font: { size: 9 } } } },
                scales: {
                    x: { display: false },
                    y: { ticks: { color: '#64748b', font: { size: 9 } }, grid: { color: '#334155' } }
                }
            }
        });

        function toggleModal(show) {
            document.getElementById('explainModal').classList.toggle('hidden', !show);
        }

        function resetarSimulacao() {
            saldo = SALDO_INICIAL;
            lucroCasa = 0;
            totalGiros = 0;
            document.getElementById('playerBalance').innerText = `R$ ${saldo.toFixed(2)}`;
            document.getElementById('houseProfit').innerText = `R$ ${lucroCasa.toFixed(2)}`;
            document.getElementById('statusText').innerText = "Simulação reiniciada!";
            document.getElementById('nearMissBanner').classList.add('hidden');
            
            chart.data.labels = [0];
            chart.data.datasets[0].data = [SALDO_INICIAL];
            chart.data.datasets[1].data = [0];
            chart.update();
        }

        async function girar(qtd) {
            if (isSpinning) return;
            if (saldo < APOS_VALOR) {
                alert("Você faliu! O saldo acabou. A casa de apostas ficou com todo seu dinheiro.");
                return;
            }

            isSpinning = true;
            document.getElementById('nearMissBanner').classList.add('hidden');

            for (let i = 0; i < qtd; i++) {
                if (saldo < APOS_VALOR) break;
                await processarRodada(qtd === 1);
            }

            isSpinning = false;
        }

        function processarRodada(animar) {
            return new Promise((resolve) => {
                totalGiros++;
                saldo -= APOS_VALOR;
                lucroCasa += APOS_VALOR;

                const modo = document.getElementById('modeSelect').value;
                let winProb = 0.30; // Modo Limpo: 30% chance de prêmio pequeno

                if (modo === 'aggressive') {
                    // Algoritmo de retenção: alto RTP no começo (isca), depois cai drasticamente
                    if (totalGiros <= 8) winProb = 0.70;      // Falsa ilusão de ganho fácil
                    else if (totalGiros <= 20) winProb = 0.25; // Começa a retenção
                    else winProb = 0.10;                       // Drenagem quase total
                }

                const ganhou = Math.random() < winProb;
                let r1, r2, r3;
                let isNearMiss = false;

                if (ganhou) {
                    const sorteada = FRUITS[Math.floor(Math.random() * FRUITS.length)];
                    r1 = r2 = r3 = sorteada;
                    const premio = APOS_VALOR * 2.5; // Paga 2.5x
                    saldo += premio;
                    lucroCasa -= premio;
                } else {
                    // Força um Near Miss (2 iguais) em 40% das derrotas para enganar o cérebro
                    if (Math.random() < 0.40) {
                        const f1 = FRUITS[Math.floor(Math.random() * FRUITS.length)];
                        let f2 = FRUITS[Math.floor(Math.random() * FRUITS.length)];
                        while(f2 === f1) f2 = FRUITS[Math.floor(Math.random() * FRUITS.length)];
                        r1 = f1; r2 = f1; r3 = f2;
                        isNearMiss = true;
                    } else {
                        r1 = FRUITS[0]; r2 = FRUITS[1]; r3 = FRUITS[2];
                    }
                }

                const delay = animar ? 250 : 10;

                if (animar) {
                    ['reel1', 'reel2', 'reel3'].forEach(id => document.getElementById(id).classList.add('spinning'));
                }

                setTimeout(() => {
                    if (animar) {
                        ['reel1', 'reel2', 'reel3'].forEach(id => document.getElementById(id).classList.remove('spinning'));
                    }

                    document.getElementById('reel1').innerText = r1;
                    document.getElementById('reel2').innerText = r2;
                    document.getElementById('reel3').innerText = r3;

                    // Atualiza Interface
                    document.getElementById('playerBalance').innerText = `R$ ${saldo.toFixed(2)}`;
                    document.getElementById('houseProfit').innerText = `R$ ${lucroCasa.toFixed(2)}`;

                    if (ganhou) {
                        document.getElementById('statusText').innerText = `🎉 VOCÊ GANHOU! +R$ ${(APOS_VALOR * 1.5).toFixed(2)}`;
                        document.getElementById('statusText').className = "text-center h-6 flex items-center justify-center text-xs font-bold text-emerald-400";
                    } else {
                        document.getElementById('statusText').innerText = `❌ PERDEU R$ ${APOS_VALOR.toFixed(2)}`;
                        document.getElementById('statusText').className = "text-center h-6 flex items-center justify-center text-xs font-bold text-rose-400";
                        if (isNearMiss && animar) {
                            document.getElementById('nearMissBanner').classList.remove('hidden');
                        }
                    }

                    // Atualiza Gráfico
                    chart.data.labels.push(totalGiros);
                    chart.data.datasets[0].data.push(saldo);
                    chart.data.datasets[1].data.push(lucroCasa);
                    chart.update();

                    resolve();
                }, delay);
            });
        }
    </script>
</body>
</html>
